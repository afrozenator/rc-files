# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

alias gln='git log --oneline --name-only'
alias gcm='git commit -m '

setopt INTERACTIVE_COMMENTS

alias python='python3'
alias c='clear'
alias rb='source ~/.zshrc'
alias ob='vim ~/.zshrc'
alias of='vim ~/.zsh_functions.sh'

# Home/End sequences used by common terminals.
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[OH' beginning-of-line
bindkey '^[OF' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line

###
# Setup history.
###

# Use built-in timestamps instead of running date for each command.
zmodload zsh/datetime

# Daily logs are separate from HISTFILE; SAVEHIST does not trim them.
# No automatic deletion; use prune_logs AGE [--dry-run] for manual cleanup.
# A subshell keeps the private umask local to this logger.
log_command() (
    emulate -L zsh
    [[ "$1" == ' '* ]] && return 0
    umask 077

    local log_dir="$HOME/.logs"
    local now="$EPOCHSECONDS" log_date log_time
    strftime -s log_date '%Y-%m-%d' "$now"
    strftime -s log_time '%H:%M:%S' "$now"
    local log_file="$log_dir/$log_date.log"
    local current_dir="$PWD"
    local tmux_session=""

    if [[ -n "${TMUX:-}" ]] &&
        tmux_session=$(tmux display-message -p '#S' 2>/dev/null); then
        tmux_session="(tmux: $tmux_session)"
    fi

    # New directories are mode 700; new files are mode 600.
    [[ -d "$log_dir" ]] || mkdir -p -m 700 -- "$log_dir" || return 0
    print -r -- "$log_time $USER $tmux_session: $current_dir : $1" >> "$log_file"

    # A logging failure must not prevent subsequent preexec hooks from running.
    return 0
)

# Hook to execute the log_command function before each command
autoload -Uz add-zsh-hook
add-zsh-hook preexec log_command

# Personal helpers, including prune_logs and ..
[[ -r "$HOME/.zsh_functions.sh" ]] && source "$HOME/.zsh_functions.sh"

##########
# HISTORY
##########

HISTFILE=$HOME/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# SHARE_HISTORY already appends immediately; these modes are mutually exclusive.
unsetopt INC_APPEND_HISTORY INC_APPEND_HISTORY_TIME

# Record timestamp in history:
setopt EXTENDED_HISTORY

# Expire duplicate entries first when trimming history:
setopt HIST_EXPIRE_DUPS_FIRST

# Dont record an entry that was just recorded again:
setopt HIST_IGNORE_DUPS

# Delete old recorded entry if new entry is a duplicate:
setopt HIST_IGNORE_ALL_DUPS

# Do not display a line previously found:
setopt HIST_FIND_NO_DUPS

# Dont record an entry starting with a space:
setopt HIST_IGNORE_SPACE

# Dont write duplicate entries in the history file:
setopt HIST_SAVE_NO_DUPS

# Share history between all sessions:
setopt SHARE_HISTORY

# Execute history expansions (e.g. !$) immediately:
unsetopt HIST_VERIFY

# https://github.com/junegunn/fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# OpenClaw CLI
export PATH="$HOME/.openclaw/bin:$PATH"

# Make GNUReadline
# Force ZLE to use standard Emacs (Readline-style) keybindings
bindkey -e

# Ensure Emacs mode is active (enables word movement widgets)
bindkey -e

# Bind Option + Left Arrow to move back a word
bindkey "\e\e[D" backward-word
bindkey "^[^[[D" backward-word
bindkey "\e[1;3D" backward-word
bindkey "\e[1;5D" backward-word

# Bind Option + Right Arrow to move forward a word
bindkey "\e\e[C" forward-word
bindkey "^[^[[C" forward-word
bindkey "\e[1;3C" forward-word
bindkey "\e[1;5C" forward-word
